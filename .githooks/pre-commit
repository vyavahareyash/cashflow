#!/usr/bin/env bash
# Cashflow Git Pre-Commit Hook
# Prevents commits that would break the CI pipeline:
# 1. Secret scanning (Gitleaks / sensitive credentials)
# 2. Code formatting (dart format)
# 3. Static analysis with zero fatal infos (flutter analyze --fatal-infos)
# 4. Unit & widget tests with coverage (flutter test --coverage >= 60%)
# 5. Script integrity (python py_compile)

set -eo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

echo -e "${BLUE}==> [pre-commit] Validating pipeline invariants...${NC}"

# Ensure Flutter and Dart are in PATH
export PATH="/Users/yash/Documents/flutter/bin:$HOME/flutter/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"

if ! command -v flutter >/dev/null 2>&1; then
    echo -e "${RED}Error: flutter binary not found in PATH.${NC}"
    echo "Please ensure Flutter SDK is installed and added to your PATH."
    exit 1
fi

if ! command -v dart >/dev/null 2>&1; then
    echo -e "${RED}Error: dart binary not found in PATH.${NC}"
    exit 1
fi

# ── 1. Secret Scanning ────────────────────────────────────────────────────────
echo -e "${BLUE}--> 1/5 Checking for exposed secrets...${NC}"
if command -v gitleaks >/dev/null 2>&1; then
    gitleaks protect --staged --verbose
else
    # Fallback regex checks on staged files
    STAGED_SECRETS=$(git diff --cached --pickaxe-regex -S'(AIzaSy[0-9A-Za-z_-]{33}|ghp_[0-9a-zA-Z]{36}|-----BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY-----)' 2>/dev/null || true)
    if [ -n "$STAGED_SECRETS" ]; then
        echo -e "${RED}Error: Potential secret or private key detected in staged changes!${NC}"
        exit 1
    fi
fi
echo -e "${GREEN}✓ Secrets scan clean.${NC}"

# ── 2. Dart Code Formatting ───────────────────────────────────────────────────
echo -e "${BLUE}--> 2/5 Checking Dart formatting...${NC}"
if ! dart format --output=none --set-exit-if-changed . ; then
    echo -e "${RED}Error: Unformatted Dart files found.${NC}"
    echo -e "${YELLOW}Fix with: dart format .${NC}"
    exit 1
fi
echo -e "${GREEN}✓ Code formatting clean.${NC}"

# ── 3. Static Analysis ────────────────────────────────────────────────────────
echo -e "${BLUE}--> 3/5 Running static analysis (fatal infos)...${NC}"
if ! flutter analyze --fatal-infos; then
    echo -e "${RED}Error: Flutter analyze failed with errors, warnings, or fatal infos.${NC}"
    exit 1
fi
echo -e "${GREEN}✓ Static analysis clean.${NC}"

# ── 4. Unit Tests & Coverage Threshold (≥60%) ─────────────────────────────────
if [ "${SKIP_TESTS:-0}" = "1" ]; then
    echo -e "${YELLOW}--> 4/5 Skipping tests (SKIP_TESTS=1 set)${NC}"
else
    echo -e "${BLUE}--> 4/5 Running tests with coverage...${NC}"
    if ! flutter test --coverage; then
        echo -e "${RED}Error: flutter test failed.${NC}"
        exit 1
    fi

    echo -e "${BLUE}--> Verifying line coverage threshold (≥60%)...${NC}"
    python3 - << 'EOF'
import sys

lines_found = 0
lines_hit = 0

try:
    with open('coverage/lcov.info', 'r') as f:
        for line in f:
            if line.startswith('LF:'):
                lines_found += int(line.strip().split(':')[1])
            elif line.startswith('LH:'):
                lines_hit += int(line.strip().split(':')[1])
except Exception as e:
    print(f"Error reading coverage/lcov.info: {e}", file=sys.stderr)
    sys.exit(1)

if lines_found == 0:
    print("Error: No coverage data found in coverage/lcov.info", file=sys.stderr)
    sys.exit(1)

cov = (lines_hit / lines_found) * 100.0
threshold = 60.0
print(f"Line coverage: {cov:.2f}% (threshold: {threshold:.1f}%)")

if cov < threshold:
    print(f"Coverage {cov:.2f}% is below threshold {threshold:.1f}%", file=sys.stderr)
    sys.exit(1)
EOF
    echo -e "${GREEN}✓ Tests & coverage threshold passed.${NC}"
fi

# ── 5. Script Syntax Verification ─────────────────────────────────────────────
echo -e "${BLUE}--> 5/5 Verifying Python scripts...${NC}"
python3 -m py_compile scripts/generate_report.py
echo -e "${GREEN}✓ Python scripts valid.${NC}"

echo -e "${GREEN}==> All pipeline checks passed successfully!${NC}"
exit 0
